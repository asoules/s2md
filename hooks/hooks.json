{
  "description": "Convert Claude Code sessions to Markdown on session end",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
